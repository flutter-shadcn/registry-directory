{
  "id": "official",
  "displayName": "shadcn_flutter_kit",
  "maintainers": [
    "ibrar-x"
  ],
  "repo": "https://github.com/mibrar-dev/shadcn_flutter_kit",
  "license": "MIT",
  "minCliVersion": "0.1.8",
  "homepage": "https://ibrar-x.github.io/shadcn_flutter_kit/",
  "description": "Official shadcn Flutter registry.",
  "baseUrl": "https://github.com/mibrar-dev/shadcn_flutter_kit/tree/1594125104d670ad002a3cca0228ca093a6120cf/flutter_shadcn_kit/lib",
  "paths": {
    "componentsJson": "registry/manifests/components.json",
    "componentsSchemaJson": "registry/manifests/components.schema.json",
    "indexJson": "registry/manifests/index.json",
    "indexSchemaJson": "registry/manifests/index.schema.json",
    "themesJson": "registry/manifests/theme.index.json",
    "themesSchemaJson": "registry/manifests/themes.index.schema.json",
    "folderStructureJson": "registry/manifests/folder_structure.json"
  },
  "install": {
    "namespace": "shadcn",
    "root": "lib/ui/shadcn"
  },
  "capabilities": {
    "sharedGroups": true,
    "composites": true,
    "theme": true
  },
  "trust": {
    "mode": "none"
  },
  "init": {
    "version": 1,
    "description": "Bootstrap shared core files and dependencies for flutter_shadcn.",
    "actions": [
      {
        "type": "message",
        "lines": [
          "shared core: theme, app_theme, util, color_extensions, form_control, form_value_supplier, localizations, localizations_extensions",
          "default components: app, shadcn_localizations, shadcn_localizations_en",
          "pub dependencies: data_widget, gap, flutter_localizations, intl"
        ]
      },
      {
        "type": "ensureDirs",
        "dirs": [
          "lib/ui/shadcn/shared"
        ]
      },
      {
        "type": "copyFiles",
        "base": "registry/shared",
        "destBase": "lib/ui/shadcn/shared",
        "overwrite": false,
        "files": [
          "theme/theme.dart",
          "theme/app_theme.dart",
          "theme/app_theme_preset.dart",
          "theme/preset_themes.dart",
          "localizations/_impl/core/shadcn_localizations.dart",
          "localizations/_impl/utils/__shadcn_localizations_delegate.dart",
          "localizations/shadcn_localizations.dart",
          "localizations/shadcn_localizations_extensions.dart",
          "theme/typography.dart",
          "theme/schema/component_schema.dart",
          "theme/component_theme_global_registry.dart",
          "theme/color_scheme.dart",
          "theme/generated_colors.dart",
          "theme/_impl/core/adaptive_scaler.dart",
          "theme/_impl/core/adaptive_scaling.dart",
          "theme/_impl/core/density.dart",
          "theme/_impl/core/design_tokens.dart",
          "theme/_impl/core/chart_color_scheme.dart",
          "theme/_impl/core/color_scheme.dart",
          "theme/_impl/core/color_schemes.dart",
          "theme/_impl/core/color_shades.dart",
          "theme/_impl/core/single_chart_color_scheme.dart",
          "theme/_impl/themes/__animated_theme_state.dart",
          "theme/_impl/themes/animated_theme.dart",
          "theme/_impl/themes/component_theme.dart",
          "theme/_impl/themes/component_theme_data.dart",
          "theme/_impl/themes/icon_theme_properties.dart",
          "theme/_impl/themes/theme.dart",
          "theme/_impl/themes/theme_data.dart",
          "theme/_impl/themes/theme_data_tween.dart",
          "utils/color_extensions.dart",
          "primitives/_impl/core/controlled_component_adapter.dart",
          "primitives/_impl/core/controlled_component_data.dart",
          "primitives/_impl/core/form_key.dart",
          "primitives/_impl/core/replace_result.dart",
          "primitives/_impl/core/validation_result.dart",
          "primitives/_impl/state/__controlled_component_adapter_state.dart",
          "primitives/_impl/utils/component_value_controller.dart",
          "primitives/form_control.dart",
          "primitives/form_value_supplier.dart",
          "utils/_impl/core/bi_directional_convert.dart",
          "utils/_impl/core/cached_value_widget.dart",
          "utils/_impl/core/callback_context_action.dart",
          "utils/_impl/core/captured_wrapper.dart",
          "utils/_impl/core/context_callback_action.dart",
          "utils/_impl/core/form_pending_builder.dart",
          "utils/_impl/core/repeated_animation_builder.dart",
          "utils/_impl/core/separated_flex.dart",
          "utils/_impl/core/time_of_day.dart",
          "utils/_impl/state/__cached_value_widget_state.dart",
          "utils/_impl/state/__captured_wrapper_state.dart",
          "utils/_impl/state/__repeated_animation_builder_state.dart",
          "utils/_impl/state/__separated_flex_state.dart",
          "utils/_impl/utils/converted_controller.dart",
          "utils/util.dart"
        ]
      },
      {
        "type": "copyFiles",
        "base": "registry/components/layout/app",
        "destBase": "lib/ui/shadcn/components/layout/app",
        "overwrite": false,
        "files": [
          "_impl/core/shadcn_ui.dart",
          "app.dart",
          "component_theme_global_configs.dart"
        ]
      },
      {
        "type": "copyFiles",
        "base": "registry/components/utility/shadcn_localizations",
        "destBase": "lib/ui/shadcn/components/utility/shadcn_localizations",
        "overwrite": false,
        "files": [
          "_impl/utils/shadcn_localizations_delegate.dart",
          "shadcn_localizations.dart"
        ]
      },
      {
        "type": "copyFiles",
        "base": "registry/components/utility/shadcn_localizations_en",
        "destBase": "lib/ui/shadcn/components/utility/shadcn_localizations_en",
        "overwrite": false,
        "files": [
          "shadcn_localizations_en.dart"
        ]
      },
      {
        "type": "copyFiles",
        "optional": true,
        "promptLabel": "Install font assets?",
        "promptDescription": "Copies selected font families to assets/fonts/.",
        "base": "registry/shared",
        "destBase": ".",
        "from": "fonts",
        "to": "assets/fonts",
        "overwrite": false,
        "groups": [
          {
            "label": "Geist Sans",
            "description": "18 weight/style variants - ~3.2 MB",
            "default": false,
            "files": [
              "geist/Geist-Black.otf",
              "geist/Geist-BlackItalic.otf",
              "geist/Geist-Bold.otf",
              "geist/Geist-BoldItalic.otf",
              "geist/Geist-ExtraLightItalic.otf",
              "geist/Geist-Light.otf",
              "geist/Geist-LightItalic.otf",
              "geist/Geist-Medium.otf",
              "geist/Geist-MediumItalic.otf",
              "geist/Geist-Regular.otf",
              "geist/Geist-RegularItalic.otf",
              "geist/Geist-SemiBold.otf",
              "geist/Geist-SemiBoldItalic.otf",
              "geist/Geist-Thin.otf",
              "geist/Geist-ThinItalic.otf",
              "geist/Geist-UltraBlack.otf",
              "geist/Geist-UltraLight.otf"
            ]
          },
          {
            "label": "Geist Mono",
            "description": "17 weight/style variants - ~2.8 MB",
            "default": false,
            "files": [
              "geist/GeistMono-Black.otf",
              "geist/GeistMono-BlackItalic.otf",
              "geist/GeistMono-Bold.otf",
              "geist/GeistMono-BoldItalic.otf",
              "geist/GeistMono-ExtraLightItalic.otf",
              "geist/GeistMono-Italic.otf",
              "geist/GeistMono-Light.otf",
              "geist/GeistMono-LightItalic.otf",
              "geist/GeistMono-Medium.otf",
              "geist/GeistMono-MediumItalic.otf",
              "geist/GeistMono-Regular.otf",
              "geist/GeistMono-SemiBold.otf",
              "geist/GeistMono-SemiBoldItalic.otf",
              "geist/GeistMono-Thin.otf",
              "geist/GeistMono-ThinItalic.otf",
              "geist/GeistMono-UltraBlack.otf",
              "geist/GeistMono-UltraLight.otf"
            ]
          },
          {
            "label": "Bootstrap icon font",
            "description": "Bootstrap icon font asset.",
            "default": false,
            "files": [
              "bootstrap.otf"
            ]
          },
          {
            "label": "Lucide icon font",
            "description": "Lucide icon font asset.",
            "default": false,
            "files": [
              "lucide.ttf"
            ]
          },
          {
            "label": "Radix icon font",
            "description": "Radix icon font asset.",
            "default": false,
            "files": [
              "radix.otf"
            ]
          }
        ]
      },
      {
        "type": "mergePubspec",
        "dependencies": {
          "data_widget": "^0.0.2",
          "gap": "^3.0.1",
          "flutter_localizations": "sdk: flutter",
          "intl": "any"
        },
        "deriveFlutterAssets": true
      }
    ]
  }
}
